<?xml version="1.0" encoding="utf-8"?>
<!-- The store build is for TVs only: with leanback required, neither Amazon nor Google offers it
     to phones or tablets, and Google reviews it as a TV app, not a large-screen one. The GitHub
     build leaves it optional so it can still be sideloaded anywhere. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-feature android:name="android.software.leanback" android:required="true" tools:replace="android:required" />
</manifest>
